# Demonstrates scoped imports.
#
# Two forms are supported (the .mh extension is optional):
#   import "mathlib"              -> brings exported names into scope directly
#   import math from "mathlib"    -> access exports via the `math` namespace
#
# Only names marked with `export` in mathlib are visible here.

import math from "mathlib"

let n = 4
print(math.square(n))
print(math.cube(n))
print(math.answer)

if math.is_even(n) {
	print("n is even")
}
