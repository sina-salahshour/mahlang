# The standard library: modules imported as "std:<name>" (docs/STDLIB.md).
# `std:math` is the first one.

import math from "std:math"

# Exact functions work on Mah's own 28-digit Numbers.
print(math.sqrt(2))                      # 1.414213562373095048801688724
print(math.round(math.pi, 4), math.floor(0 - 2.5), math.ceil(2.1))

# Trigonometry and logarithms are computed in double precision.
let angle = math.atan2(1, 1)             # 45 degrees
print(math.round(angle * 180 / math.pi, 6))
print(math.log10(1000), math.round(math.exp(1), 3))

# Bad input throws a catchable RuntimeError.
print(try math.log(0) else "log(0) is undefined")

# A distance helper built from std:math.
struct Point { x: Number, y: Number }

fn distance(a: Point, b: Point) -> Number {
    math.sqrt(math.pow(b.x - a.x, 2) + math.pow(b.y - a.y, 2))
}

print(distance(Point { x: 0, y: 0 }, Point { x: 3, y: 4 }))

# `sin`/`cos` still work with no import at all.
print(sin(0), cos(0))
