# A small module with tests next to it, in shapes.test.mh. Run them with
#   mah test --file examples/testing/shapes.test.mh
# (inside a project, plain `mah test` finds every *.test.mh file).

enum Shape {
    Circle { r: Number },
    Rect { w: Number, h: Number }
}

enum ShapeError { Negative }

impl Error for ShapeError {
    fn message(self) { "sizes can't be negative" }
}

# Not exported, yet shapes.test.mh can still test it.
fn check_size(n: Number) {
    if n < 0 { throw ShapeError.Negative }
}

export fn circle(r: Number) -> Shape {
    check_size(r)
    Shape.Circle { r: r }
}

export fn rect(w: Number, h: Number) -> Shape {
    check_size(w)
    check_size(h)
    Shape.Rect { w: w, h: h }
}

export fn area(s: Shape) -> Number {
    match s {
        Shape.Circle { r } => { 3 * r * r } # close enough for a demo
        Shape.Rect { w, h } => { w * h }
    }
}
