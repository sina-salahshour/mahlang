# input() gives a String (EndOfInput at the end of the input); to_number()
# throws NumberParseError if it isn't one -- either way, use 0.
let x = try input("decimal: ").to_number() else 0
let res = 0
let i = 0
while x {
	let rem = x % 2
	x = x // 2

	res = res + rem * 10 ** i;

	i = i + 1
}

print(res)
