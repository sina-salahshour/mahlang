# Tests for std:fs, run by tests/test_stdlib.py (or
# `mah test --file mah/std/fs.test.mh`). Each test works in a fresh
# temporary directory, removed at the end.
import "std:test"
import fs from "./fs"
import bytes from "./bytes"

fn scratch() -> String { fs.temp_dir() }

fn error_of(f: fn() -> Unknown) -> String {
    let e = assert_throws(f)
    match e {
        fs.FsError { kind, op, path, description } => { kind + " " + op + ": " + description }
        RuntimeError.TypeMismatch { message } => { "TypeMismatch: " + message }
        RuntimeError.ArgumentError { message } => { "ArgumentError: " + message }
        _ => { "not an FsError: " + e.message() }
    }
}

test "whole files" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    let p = dir + "/a.txt"
    fs.write_text(p, "one\ntwo\r\n")
    fs.append_text(p, "héllo")
    assert_eq(fs.read_text(p), "one\ntwo\r\nhéllo")
    fs.write_text(p, "replaced")
    assert_eq(fs.read_text(p), "replaced")
    fs.append_text(dir + "/new.txt", "x")
    assert_eq(fs.read_text(dir + "/new.txt"), "x")
    fs.write_text(dir + "/empty.txt", "")
    assert_eq(fs.read_text(dir + "/empty.txt"), "")
}

test "info, exists, is_file, is_dir" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    let p = dir + "/a.txt"
    fs.write_text(p, "12345é")
    let i = fs.info(p)
    assert_eq([i.kind, i.size].join(" "), "file 7")
    assert(i.modified > 1700000000)
    assert_eq(fs.info(dir).kind, "dir")
    assert(fs.exists(p))
    assert(fs.is_file(p))
    assert(!fs.is_dir(p))
    assert(fs.is_dir(dir))
    assert(!fs.exists(dir + "/nope"))
    assert(!fs.is_file(dir + "/nope"))
}

test "directories" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    fs.mkdir(dir + "/b")
    fs.mkdir(dir + "/a/x/y", parents: true)
    fs.mkdir(dir + "/a/x", parents: true)
    fs.write_text(dir + "/c.txt", "")
    assert_eq(fs.list_dir(dir).join(","), "a,b,c.txt")
    fs.remove(dir + "/b")
    fs.remove(dir + "/c.txt")
    fs.remove(dir + "/a", recursive: true)
    assert_eq(fs.list_dir(dir).len(), 0)
}

test "rename and copy" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    fs.write_text(dir + "/a", "data")
    fs.copy(dir + "/a", dir + "/b")
    fs.rename(dir + "/a", dir + "/c")
    assert_eq(fs.list_dir(dir).join(","), "b,c")
    assert_eq(fs.read_text(dir + "/b") + fs.read_text(dir + "/c"), "datadata")
    fs.write_text(dir + "/d", "new")
    fs.rename(dir + "/d", dir + "/c")
    assert_eq(fs.read_text(dir + "/c"), "new")
}

test "errors" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    fs.write_text(dir + "/f", "x")
    fs.mkdir(dir + "/d")
    fs.write_text(dir + "/d/inner", "x")
    assert_eq(
        error_of(fn() { fs.read_text(dir + "/missing") }),
        "not_found read_text: no such file or directory"
    )
    assert_eq(
        error_of(fn() { fs.read_text(dir + "/d") }),
        "is_a_directory read_text: is a directory"
    )
    assert_eq(error_of(fn() { fs.mkdir(dir + "/d") }), "already_exists mkdir: already exists")
    assert_eq(
        error_of(fn() { fs.mkdir(dir + "/no/such") }),
        "not_found mkdir: no such file or directory"
    )
    assert_eq(
        error_of(fn() { fs.remove(dir + "/d") }),
        "directory_not_empty remove: directory not empty"
    )
    assert_eq(
        error_of(fn() { fs.list_dir(dir + "/f") }),
        "not_a_directory list_dir: not a directory"
    )
    assert_eq(
        error_of(fn() { fs.copy(dir + "/d", dir + "/e") }),
        "is_a_directory copy: is a directory"
    )
    assert_eq(
        error_of(fn() { fs.write_text(dir + "/f/x", "") }),
        "not_a_directory write_text: not a directory"
    )
    let e = assert_throws(fn() { fs.read_text(dir + "/missing") })
    assert_eq(e.message(), "read_text: no such file or directory: " + dir + "/missing")
}

test "non-ASCII text round-trips" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    fs.write_text(dir + "/u", "ÿ日本")
    assert_eq(fs.read_text(dir + "/u"), "ÿ日本")
}

test "open files" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    let p = dir + "/lines.txt"
    let w = fs.open(p, "w")
    w.write("first\r\n")
    w.write("second\nthird")
    w.close()
    let a = fs.open(p, "a")
    a.write("\nfourth\n")
    a.close()
    let f = fs.open(p)
    assert_eq("" + f, "File(\"" + p + "\", \"r\")")
    assert_eq(f.read_line(), "first")
    let rest = []
    for let line in f.lines() {
        rest.push(line)
    }
    assert_eq(rest.join("|"), "second|third|fourth")
    assert_eq(f.read_line(), none)
    f.close()
    f.close()
    assert_eq(error_of(fn() { f.read_line() }), "closed read_line: the file is closed")
    let g = fs.open(p)
    defer g.close()
    assert_eq(g.read_all().len(), 27)
    assert_eq(error_of(fn() { g.write("x") }), "other write: the file isn't open for writing")
    assert_eq(
        error_of(fn() { fs.open(dir + "/missing") }),
        "not_found open: no such file or directory"
    )
    assert_eq(error_of(fn() { fs.open(dir) }), "is_a_directory open: is a directory")
    assert_eq(
        assert_throws(fn() { fs.open(p, "x") }).message,
        "open: mode must be \"r\", \"w\" or \"a\", got \"x\""
    )
}

test "glob" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    fs.mkdir(dir + "/src/lib/deep", parents: true)
    for let name in [
        "src/main.mh",
        "src/lib/a.mh",
        "src/lib/b.txt",
        "src/lib/deep/c.mh",
        "src/.hidden.mh",
        "top.mh",
        "top2.mh"
    ] {
        fs.write_text(dir + "/" + name, "")
    }
    let rel = fn(pattern: String) -> String {
        fs.glob(dir + "/" + pattern).map(fn(p) { p[dir.len() + 1..] }).reduce().join(" ")
    }
    assert_eq(rel("*.mh"), "top.mh top2.mh")
    assert_eq(rel("top?.mh"), "top2.mh")
    assert_eq(rel("src/**/*.mh"), "src/lib/a.mh src/lib/deep/c.mh src/main.mh")
    assert_eq(rel("**/*.txt"), "src/lib/b.txt")
    assert_eq(rel("src/.*"), "src/.hidden.mh")
    assert_eq(rel("src/lib/[ab].*"), "src/lib/a.mh src/lib/b.txt")
    assert_eq(rel("src/lib/[!a]*"), "src/lib/b.txt src/lib/deep")
    assert_eq(rel("nothing*"), "")
    assert_eq(rel("src/main.mh"), "src/main.mh")
}

test "detached reads run alongside timers" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    fs.write_text(dir + "/a", "A")
    fs.write_text(dir + "/b", "B")
    let pa = detach fs.read_text(dir + "/a")
    let pb = detach fs.read_text(dir + "/b")
    sleep_async(5)
    assert_eq(pa.await + pb.await, "AB")
}

test "whole binary files" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    let p = dir + "/data.bin"
    let all = bytes.new()
    for let i in 0..256 { all.push(i) }
    fs.write_bytes(p, all)
    assert(fs.read_bytes(p) == all)
    assert_eq(fs.info(p).size, 256)
    fs.append_bytes(p, bytes.from_vector([1, 2]))
    assert_eq(fs.read_bytes(p).len(), 258)
    assert_eq(fs.read_bytes(p)[256], 1)
    fs.write_bytes(p, "hi".to_bytes())
    assert_eq("" + fs.read_bytes(p), "Bytes[68 69]")
    fs.append_bytes(dir + "/new.bin", bytes.from_vector([255]))
    assert_eq("" + fs.read_bytes(dir + "/new.bin"), "Bytes[ff]")
    fs.write_bytes(dir + "/empty.bin", bytes.new())
    assert_eq(fs.read_bytes(dir + "/empty.bin").len(), 0)
    # bytes that aren't UTF-8 come back untouched
    fs.write_bytes(p, bytes.from_vector([255, 254, 0, 10, 13]))
    assert_eq("" + fs.read_bytes(p), "Bytes[ff fe 00 0a 0d]")
}

test "binary and text files agree" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    let p = dir + "/a.txt"
    fs.write_text(p, "héllo\r\n")
    assert_eq("" + fs.read_bytes(p), "Bytes[68 c3 a9 6c 6c 6f 0d 0a]")
    fs.write_bytes(p, "wörld".to_bytes())
    assert_eq(fs.read_text(p), "wörld")
    fs.append_bytes(p, "!".to_bytes())
    assert_eq(fs.read_text(p), "wörld!")
}

test "write_bytes copies the data when called" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    let p = dir + "/a.bin"
    let data = bytes.from_vector([1, 2, 3])
    let pending = detach fs.write_bytes(p, data)
    data.push(4)
    data[0] = 9
    pending.await
    assert_eq("" + fs.read_bytes(p), "Bytes[01 02 03]")
}

test "binary errors" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    assert_eq(
        error_of(fn() { fs.read_bytes(dir + "/missing") }),
        "not_found read_bytes: no such file or directory"
    )
    assert_eq(error_of(fn() { fs.read_bytes(dir) }), "is_a_directory read_bytes: is a directory")
    assert_eq(
        error_of(fn() { fs.write_bytes(dir + "/no/dir/x", bytes.new()) }),
        "not_found write_bytes: no such file or directory"
    )
    assert_eq(
        error_of(fn() { fs.append_bytes(dir, bytes.new()) }),
        "is_a_directory append_bytes: is a directory"
    )
    let e = assert_throws(fn() { fs.read_bytes(dir + "/missing") })
    assert_eq(e.path, dir + "/missing")
}

test "reading bytes from an open file" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    let p = dir + "/data.bin"
    fs.write_bytes(p, bytes.from_vector([1, 2, 3, 4, 5]))
    let f = fs.open(p)
    defer f.close()
    assert_eq("" + f.read_bytes(2), "Bytes[01 02]")
    assert_eq("" + f.read_bytes(0), "Bytes[]")
    assert_eq("" + f.read_bytes(2), "Bytes[03 04]")
    assert_eq("" + f.read_bytes(10), "Bytes[05]")
    assert_eq("" + f.read_bytes(1), "Bytes[]")
    assert_eq("" + f.read_bytes(), "Bytes[]")
    let g = fs.open(p)
    defer g.close()
    assert_eq("" + g.read_bytes(), "Bytes[01 02 03 04 05]")
    assert_eq("" + g.read_bytes(), "Bytes[]")
    let h = fs.open(p)
    defer h.close()
    h.read_bytes(1)
    assert_eq("" + h.read_bytes(none), "Bytes[02 03 04 05]")
    fs.write_bytes(dir + "/empty.bin", bytes.new())
    let z = fs.open(dir + "/empty.bin")
    defer z.close()
    assert_eq(z.read_bytes(4).len(), 0)
}

test "read_bytes checks max" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    fs.write_bytes(dir + "/a", bytes.new(3))
    let f = fs.open(dir + "/a")
    defer f.close()
    assert_eq(
        error_of(fn() { f.read_bytes(-1) }),
        "ArgumentError: file_read_bytes: max must be a whole number of at least 0, got -1"
    )
    assert_eq(
        error_of(fn() { f.read_bytes(1.5) }),
        "ArgumentError: file_read_bytes: max must be a whole number of at least 0, got 1.5"
    )
    assert_eq(
        error_of(fn() { f.read_bytes("2") }),
        "TypeMismatch: file_read_bytes: max must be a Number or none, got String"
    )
}

test "writing bytes to an open file" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    let p = dir + "/out.bin"
    let w = fs.open(p, "w")
    w.write_bytes(bytes.from_vector([0, 1]))
    w.write_bytes(bytes.new())
    w.write_bytes(bytes.from_vector([255]))
    w.close()
    assert_eq("" + fs.read_bytes(p), "Bytes[00 01 ff]")
    let a = fs.open(p, "a")
    a.write_bytes(bytes.from_vector([7]))
    a.close()
    assert_eq("" + fs.read_bytes(p), "Bytes[00 01 ff 07]")
    let t = fs.open(p, "w")
    t.write_bytes(bytes.from_vector([9]))
    t.close()
    assert_eq("" + fs.read_bytes(p), "Bytes[09]")
}

test "text and bytes mix on one file" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    let p = dir + "/mixed"
    let w = fs.open(p, "w")
    w.write("head\n")
    w.write_bytes(bytes.from_vector([0, 255]))
    w.write("tail\n")
    w.close()
    assert_eq(fs.read_bytes(p).len(), 12)
    let f = fs.open(p)
    defer f.close()
    assert_eq(f.read_line(), "head")
    assert_eq("" + f.read_bytes(2), "Bytes[00 ff]")
    assert_eq(f.read_line(), "tail")
    assert_eq(f.read_line(), none)
    let g = fs.open(p)
    defer g.close()
    assert_eq("" + g.read_bytes(5), "Bytes[68 65 61 64 0a]")
    assert_eq(g.read_bytes(2).len(), 2)
    assert_eq(g.read_all(), "tail\n")
}

test "binary open-mode errors" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    let p = dir + "/a.bin"
    fs.write_bytes(p, bytes.from_vector([1]))
    let r = fs.open(p)
    defer r.close()
    assert_eq(
        error_of(fn() { r.write_bytes(bytes.new()) }),
        "other write_bytes: the file isn't open for writing"
    )
    let w = fs.open(dir + "/w.bin", "w")
    defer w.close()
    assert_eq(
        error_of(fn() { w.read_bytes(1) }),
        "other read_bytes: the file isn't open for reading"
    )
    assert_eq(
        error_of(fn() { w.read_bytes() }),
        "other read_bytes: the file isn't open for reading"
    )
    assert_eq(
        error_of(fn() { fs.write_bytes(p, "text") }),
        "TypeMismatch: write_bytes: data must be Bytes, got String"
    )
    assert_eq(
        error_of(fn() { fs.append_bytes(p, [1]) }),
        "TypeMismatch: append_bytes: data must be Bytes, got Vector"
    )
    assert_eq(
        error_of(fn() { w.write_bytes("x") }),
        "TypeMismatch: file_write_bytes: data must be Bytes, got String"
    )
    let c = fs.open(p)
    c.close()
    assert_eq(error_of(fn() { c.read_bytes(1) }), "closed read_bytes: the file is closed")
    assert_eq(
        error_of(fn() { c.write_bytes(bytes.new()) }),
        "closed write_bytes: the file is closed"
    )
}

test "bytes reads run alongside timers" {
    let dir = scratch()
    defer fs.remove(dir, recursive: true)
    fs.write_bytes(dir + "/a", bytes.from_vector([1]))
    fs.write_bytes(dir + "/b", bytes.from_vector([2]))
    let pa = detach fs.read_bytes(dir + "/a")
    let pb = detach fs.read_bytes(dir + "/b")
    sleep_async(5)
    assert_eq(pa.await + pb.await, bytes.from_vector([1, 2]))
}
