# Tests for std:collections, run by tests/test_stdlib.py (or
# `mah test --file mah/std/collections.test.mh`).
import "std:test"
import "./collections"

test "Set keeps distinct values in first-added order" {
    let s = Set.of([3, 1, 3, 2])
    assert_eq("" + s, "Set[3, 1, 2]")
    assert_eq(s.len(), 3)
    s.add(1)
    s.add(9)
    assert_eq(s.to_vector().join(","), "3,1,2,9")
    assert(s.has(9))
    assert(s.remove(9))
    assert(!s.remove(9))
    assert(!s.has(9))
    assert(Set.new().is_empty())
    let c = s.copy()
    c.clear()
    assert_eq([c.len(), s.len()].join(","), "0,3")
}

test "Set algebra" {
    let a = Set.of([1, 2, 3])
    let b = Set.of([3, 4])
    assert_eq("" + a.union(b), "Set[1, 2, 3, 4]")
    assert_eq("" + a.intersection(b), "Set[3]")
    assert_eq("" + a.difference(b), "Set[1, 2]")
    assert(Set.of([3]).is_subset(b))
    assert(!a.is_subset(b))
    assert(a.equals(Set.of([3, 2, 1])))
    assert(!a.equals(b))
    # the operands are unchanged
    assert_eq("" + a, "Set[1, 2, 3]")
}

test "Set is Iterable" {
    let total = 0
    for let x in Set.of([1, 2, 2, 3]) {
        total = total + x
    }
    assert_eq(total, 6)
    assert_eq(Set.of(["a", "b"]).map(fn(x) { x + "!" }).reduce().join(), "a!b!")
}

test "Deque pushes and pops at both ends" {
    let d = Deque.of([2, 3])
    d.push_front(1)
    d.push_back(4)
    d.push_front(0)
    assert_eq("" + d, "Deque[0, 1, 2, 3, 4]")
    assert_eq([d.len(), d.front(), d.back(), d.get(1), d.get(0 - 1)].join(","), "5,0,4,1,4")
    assert_eq(d.get(5), none)
    assert_eq(d.pop_front(), 0)
    assert_eq(d.pop_back(), 4)
    assert_eq(d.to_vector().join(","), "1,2,3")
    assert_eq(d.reduce(fn(a, b) { a + b }), 6)
    d.clear()
    assert(d.is_empty())
    assert_eq(d.pop_front(), none)
    assert_eq(d.pop_back(), none)
    assert_eq(d.front(), none)
}

test "Deque as a queue" {
    let q = Deque.new()
    let out = []
    for let i in 0..5 {
        q.push_back(i)
        if i % 2 == 1 { out.push(q.pop_front()) }
    }
    while !q.is_empty() {
        out.push(q.pop_front())
    }
    assert_eq(out.join(","), "0,1,2,3,4")
}

test "PriorityQueue gives the smallest first, ties in push order" {
    let pq = PriorityQueue.of([5, 1, 4, 1, 3])
    pq.push(2)
    assert_eq(pq.peek(), 1)
    assert_eq(pq.len(), 6)
    assert_eq("" + pq, "PriorityQueue[1, 1, 2, 3, 4, 5]")
    let out = []
    while !pq.is_empty() {
        out.push(pq.pop())
    }
    assert_eq(out.join(","), "1,1,2,3,4,5")
    assert_eq(pq.pop(), none)
    assert_eq(pq.peek(), none)
    let by_len = PriorityQueue.new(fn(w) { w.len() })
    for let w in ["ccc", "a", "bb", "dd", "e"] {
        by_len.push(w)
    }
    assert_eq(by_len.to_vector().join(","), "a,e,bb,dd,ccc")
    # to_vector and iterating leave the queue as it was
    assert_eq(by_len.len(), 5)
}

test "PriorityQueue with a negating key gives the largest first" {
    let out = []
    for let x in PriorityQueue.of([3, 9, 1, 9], fn(x) { 0 - x }) {
        out.push(x)
    }
    assert_eq(out.join(","), "9,9,3,1")
}

test "PriorityQueue orders many items" {
    let pq = PriorityQueue.new()
    let x = 7
    for let i in 0..200 {
        x = (x * 31 + 11) % 101
        pq.push(x)
    }
    let last = 0 - 1
    while !pq.is_empty() {
        let y = pq.pop()
        assert(y >= last)
        last = y
    }
}
