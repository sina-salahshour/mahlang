# std:time -- clocks, UTC dates and times, formatting (docs/STDLIB.md).
#
#   import time from "std:time"
#   let t = time.now()                           # seconds since 1970 (UTC)
#   let d = time.utc(t)                          # DateTime { year, month, ... }
#   time.format(d, "%Y-%m-%d %H:%M")             # 2026-09-28 12:01
#   let start = time.monotonic()                 # for measuring how long
#   ...
#   print(time.duration_text(time.monotonic() - start))    # 1.25s
#
# Times are Numbers of seconds (to the millisecond) since 1970-01-01
# 00:00:00 UTC, and durations are Numbers of seconds, so ordinary arithmetic
# works on both: `t + 90`, `b - a`. A DateTime is a calendar reading of one
# in UTC; there are no time zones yet.

extern fn now_ms() -> Number = "time.now_ms"
extern fn monotonic_ms() -> Number = "time.monotonic_ms"

# `parse` couldn't read the text with the pattern (or a pattern is bad).
export struct TimeError { message: String }

impl Error for TimeError {
    fn message(self) -> String { self.message }
}

# The wall-clock time: seconds since 1970-01-01 00:00:00 UTC, with
# milliseconds. It can jump (the system clock is adjustable); use
# `monotonic` to measure durations.
export fn now() -> Number { now_ms() / 1000 }

# Seconds (with milliseconds) since the program started, never going
# backwards -- for measuring how long something takes.
export fn monotonic() -> Number { monotonic_ms() / 1000 }

# -- calendar arithmetic (proleptic Gregorian, H. Hinnant's algorithms) ---------

fn floor_div(a: Number, b: Number) -> Number {
    let q = a // b
    if q * b > a { q - 1 } else { q }
}

# Days since 1970-01-01 of a date.
fn days_from_civil(year: Number, month: Number, day: Number) -> Number {
    let y = if month <= 2 { year - 1 } else { year }
    let era = floor_div(y, 400)
    let yoe = y - era * 400
    let mp = if month > 2 { month - 3 } else { month + 9 }
    let doy = (153 * mp + 2) // 5 + day - 1
    let doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
    era * 146097 + doe - 719468
}

fn is_leap(year: Number) -> Bool {
    if year % 4 != 0 { return false }
    if year % 100 != 0 { return true }
    year % 400 == 0
}

fn days_in_month(year: Number, month: Number) -> Number {
    if month == 2 { return if is_leap(year) { 29 } else { 28 } }
    if month == 4 | month == 6 | month == 9 | month == 11 { 30 } else { 31 }
}

# A moment as a calendar date and time of day, in UTC. `weekday` counts
# from Monday = 1 to Sunday = 7 (ISO 8601).
export struct DateTime {
    year: Number,
    month: Number,
    day: Number,
    hour: Number,
    minute: Number,
    second: Number,
    millisecond: Number
}

impl DateTime {
    # The moment as seconds since 1970 (UTC), like `now()`.
    fn timestamp(self) -> Number {
        let days = days_from_civil(self.year, self.month, self.day)
        days * 86400 + self.hour * 3600 + self.minute * 60 + self.second + self.millisecond / 1000
    }

    fn weekday(self) -> Number {
        let d = days_from_civil(self.year, self.month, self.day)
        # 1970-01-01 was a Thursday (4)
        (d % 7 + 7 + 3) % 7 + 1
    }

    # The day of the year, from 1.
    fn day_of_year(self) -> Number {
        days_from_civil(self.year, self.month, self.day) - days_from_civil(self.year, 1, 1) + 1
    }
}

fn pad(n: Number, width: Number) -> String {
    let text = "" + (if n < 0 { 0 - n } else { n })
    (if n < 0 { "-" } else { "" }) + text.pad_start(width, "0")
}

impl Printable for DateTime {
    # ISO 8601: 2026-09-28T12:01:07.250Z
    fn to_string(self) {
        let ms = if self.millisecond == 0 { "" } else { "." + pad(self.millisecond, 3) }
        pad(self.year, 4) + "-" + pad(self.month, 2) + "-" + pad(self.day, 2) + "T" + pad(
            self.hour,
            2
        ) + ":" + pad(self.minute, 2) + ":" + pad(self.second, 2) + ms + "Z"
    }
}

# The UTC calendar reading of `timestamp` (seconds since 1970, rounded down
# to the millisecond).
export fn utc(timestamp: Number) -> DateTime {
    let total_ms = floor_div(timestamp * 1000, 1)
    let days = floor_div(total_ms, 86400000)
    let ms_of_day = total_ms - days * 86400000
    let z = days + 719468
    let era = floor_div(z, 146097)
    let doe = z - era * 146097
    let yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    let doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
    let mp = (5 * doy + 2) // 153
    let day = doy - (153 * mp + 2) // 5 + 1
    let month = if mp < 10 { mp + 3 } else { mp - 9 }
    let year = yoe + era * 400 + (if month <= 2 { 1 } else { 0 })
    DateTime {
        year: year,
        month: month,
        day: day,
        hour: ms_of_day // 3600000,
        minute: ms_of_day // 60000 % 60,
        second: ms_of_day // 1000 % 60,
        millisecond: ms_of_day % 1000
    }
}

# A DateTime from its parts (time of day optional); throws TimeError for
# an impossible one (month 13, February 30, hour 24, ...).
export fn date(
    year: Number,
    month: Number,
    day: Number,
    hour: Number = 0,
    minute: Number = 0,
    second: Number = 0,
    millisecond: Number = 0
) -> DateTime throws TimeError {
    let parts = [year, month, day, hour, minute, second, millisecond]
    for let n in parts {
        if n != n // 1 {
            throw TimeError { message: "date: every part must be a whole number, got " + n }
        }
    }
    if month < 1 | month > 12 { throw TimeError { message: "date: no month " + month } }
    if day < 1 | day > days_in_month(year, month) {
        throw TimeError {
            message: "date: " + pad(year, 4) + "-" + pad(month, 2) + " has no day " + day
        }
    }
    if hour < 0 | hour > 23 | minute < 0 | minute > 59 | second < 0 | second > 59 | millisecond < 0 | millisecond > 999 {
        throw TimeError {
            message: "date: no time of day " + hour + ":" + minute + ":" + second + "." + millisecond
        }
    }
    DateTime {
        year: year,
        month: month,
        day: day,
        hour: hour,
        minute: minute,
        second: second,
        millisecond: millisecond
    }
}

# -- formatting and parsing ----------------------------------------------------

let month_names = [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December"
]
let day_names = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]

# `dt` written out by `pattern`, whose %-codes are: %Y year, %m month
# (01-12), %d day (01-31), %H hour (00-23), %M minute, %S second, %f
# millisecond (000-999), %j day of the year (001-366), %B / %b month name
# / its first 3 letters, %A / %a weekday name / first 3 letters, %% a %.
# Anything else is copied. An unknown code is a RuntimeError.ArgumentError
# (a mistake in the program, not in its data).
export fn format(dt: DateTime, pattern: String) -> String {
    let out = []
    let i = 0
    let n = pattern.len()
    while i < n {
        let c = pattern[i]
        if c != "%" {
            out.push(c)
            i = i + 1
            continue
        }
        if i + 1 >= n {
            throw RuntimeError.ArgumentError { message: "format: the pattern ends with %" }
        }
        let code = pattern[i + 1]
        i = i + 2
        if code == "Y" {
            out.push(pad(dt.year, 4))
        } elif code == "m" {
            out.push(pad(dt.month, 2))
        } elif code == "d" {
            out.push(pad(dt.day, 2))
        } elif code == "H" {
            out.push(pad(dt.hour, 2))
        } elif code == "M" {
            out.push(pad(dt.minute, 2))
        } elif code == "S" {
            out.push(pad(dt.second, 2))
        } elif code == "f" {
            out.push(pad(dt.millisecond, 3))
        } elif code == "j" {
            out.push(pad(dt.day_of_year(), 3))
        } elif code == "B" {
            out.push(month_names[dt.month - 1])
        } elif code == "b" {
            out.push(month_names[dt.month - 1][..3])
        } elif code == "A" {
            out.push(day_names[dt.weekday() - 1])
        } elif code == "a" {
            out.push(day_names[dt.weekday() - 1][..3])
        } elif code == "%" {
            out.push("%")
        } else {
            throw RuntimeError.ArgumentError { message: "format: unknown code %" + code }
        }
    }
    out.join()
}

struct __Reader { text: String, pos: Number }

impl __Reader {
    # A number of `min` to `max` digits.
    fn digits(self, min: Number, max: Number, what: String) -> Number throws TimeError {
        let start = self.pos
        while self.pos < self.text.len() & self.pos - start < max {
            let c = self.text[self.pos]
            if c < "0" | c > "9" { break }
            self.pos = self.pos + 1
        }
        if self.pos - start < min {
            throw TimeError { message: "parse: expected " + what + " at position " + start }
        }
        # only digits, so never none
        self.text[start..self.pos].parse_number()
    }

    # One of `names` (or its first 3 letters, when `short`), any case: its
    # index from 1.
    fn name(self, names: Vector<String>, short: Bool, what: String) -> Number throws TimeError {
        let i = 0
        while i < names.len() {
            let word = if short { names[i][..3] } else { names[i] }
            let end = self.pos + word.len()
            if end <= self.text.len() {
                if self.text[self.pos..end].to_lower() == word.to_lower() {
                    self.pos = end
                    return i + 1
                }
            }
            i = i + 1
        }
        throw TimeError { message: "parse: expected " + what + " at position " + self.pos }
    }
}

# The DateTime `text` spells in `pattern` (the codes `format` writes; parts
# the pattern leaves out are 0, or 1 for the month and day). Throws
# TimeError when the text doesn't match, or names an impossible date.
export fn parse(text: String, pattern: String) -> DateTime throws TimeError {
    let r = __Reader { text: text, pos: 0 }
    let v = [1970, 1, 1, 0, 0, 0, 0]
    let i = 0
    let n = pattern.len()
    while i < n {
        let c = pattern[i]
        if c != "%" {
            if r.pos >= text.len() {
                throw TimeError { message: "parse: expected \"" + c + "\" at position " + r.pos }
            }
            if text[r.pos] != c {
                throw TimeError { message: "parse: expected \"" + c + "\" at position " + r.pos }
            }
            r.pos = r.pos + 1
            i = i + 1
            continue
        }
        if i + 1 >= n { throw TimeError { message: "parse: the pattern ends with %" } }
        let code = pattern[i + 1]
        i = i + 2
        if code == "Y" {
            v[0] = r.digits(4, 4, "a 4-digit year")
        } elif code == "m" {
            v[1] = r.digits(1, 2, "a month")
        } elif code == "d" {
            v[2] = r.digits(1, 2, "a day")
        } elif code == "H" {
            v[3] = r.digits(1, 2, "an hour")
        } elif code == "M" {
            v[4] = r.digits(1, 2, "a minute")
        } elif code == "S" {
            v[5] = r.digits(1, 2, "a second")
        } elif code == "f" {
            v[6] = r.digits(3, 3, "3 digits of milliseconds")
        } elif code == "B" {
            v[1] = r.name(month_names, false, "a month name")
        } elif code == "b" {
            v[1] = r.name(month_names, true, "a month name")
        } elif code == "A" {
            r.name(day_names, false, "a weekday name")
        } elif code == "a" {
            r.name(day_names, true, "a weekday name")
        } elif code == "%" {
            if r.pos >= text.len() {
                throw TimeError { message: "parse: expected \"%\" at position " + r.pos }
            }
            if text[r.pos] != "%" {
                throw TimeError { message: "parse: expected \"%\" at position " + r.pos }
            }
            r.pos = r.pos + 1
        } else {
            throw TimeError { message: "parse: unknown code %" + code }
        }
    }
    if r.pos < text.len() {
        throw TimeError { message: "parse: unexpected text at position " + r.pos }
    }
    date(v[0], v[1], v[2], v[3], v[4], v[5], v[6])
}

# `dt` as ISO 8601 text (what printing it shows), and back: `parse_iso`
# reads "2026-09-28", "2026-09-28T12:01", "...:07", "...:07.250", each
# optionally ending in "Z".
export fn iso(dt: DateTime) -> String { dt.to_string() }

export fn parse_iso(text: String) -> DateTime throws TimeError {
    let t = if text.ends_with("Z") { text[..text.len() - 1] } else { text }
    let n = t.len()
    if n == 10 { return parse(t, "%Y-%m-%d") }
    if n == 16 { return parse(t, "%Y-%m-%dT%H:%M") }
    if n == 19 { return parse(t, "%Y-%m-%dT%H:%M:%S") }
    if n == 23 { return parse(t, "%Y-%m-%dT%H:%M:%S.%f") }
    throw TimeError { message: "parse_iso: not an ISO 8601 date and time: \"" + text + "\"" }
}

# A duration in seconds as short text: "250ms", "1.5s", "2m 5s", "3h 0m 7s",
# "2d 4h 0m 0s".
export fn duration_text(seconds: Number) -> String {
    if seconds < 0 { return "-" + duration_text(0 - seconds) }
    if seconds < 1 { return "" + floor_div(seconds * 1000, 1) + "ms" }
    if seconds < 60 { return "" + floor_div(seconds * 1000, 1) / 1000 + "s" }
    let whole = floor_div(seconds, 1)
    let s = whole % 60
    let m = whole // 60 % 60
    let h = whole // 3600 % 24
    let d = whole // 86400
    if d > 0 { return "" + d + "d " + h + "h " + m + "m " + s + "s" }
    if h > 0 { return "" + h + "h " + m + "m " + s + "s" }
    "" + m + "m " + s + "s"
}
