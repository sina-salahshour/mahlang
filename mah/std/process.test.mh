# Tests for std:process, run by tests/test_stdlib.py (or
# `mah test --file mah/std/process.test.mh`) on both VMs. They start real
# programs (sh, cat, tr), so they need a Unix-like system.
import "std:test"
import process from "./process"
import fs from "./fs"

test "exit code, stdout and stderr" {
    let o = process.run("sh", ["-c", "printf out; printf err 1>&2; exit 3"])
    assert_eq(o.code, 3)
    assert_eq(o.stdout, "out")
    assert_eq(o.stderr, "err")
    assert(!o.ok())
}

test "stdin" {
    let o = process.run("cat", stdin: "hello\n")
    assert_eq(o.stdout, "hello\n")
    assert_eq(o.code, 0)
    assert(o.ok())
    assert_eq(process.run("cat").stdout, "")
}

test "environment overrides, set and remove" {
    let show = ["-c", "printf %s \"$MAH_X\""]
    assert_eq(process.run("sh", show, env: some(["MAH_X": "1"])).stdout, "1")
    assert_eq(process.run("sh", show).stdout, "")

    process.env_set("MAH_Y", "2")
    assert_eq(process.env_get("MAH_Y").unwrap(), "2")
    assert_eq(process.run("sh", ["-c", "printf %s \"$MAH_Y\""]).stdout, "2")
    assert_eq(process.env()["MAH_Y"], "2")
    process.env_remove("MAH_Y")
    assert(process.env_get("MAH_Y") == none)
    assert_eq(process.run("sh", ["-c", "printf %s \"$MAH_Y\""]).stdout, "")
    process.env_remove("MAH_Y")
}

test "an override wins over the table" {
    process.env_set("MAH_Z", "table")
    defer process.env_remove("MAH_Z")
    let show = ["-c", "printf %s \"$MAH_Z\""]
    assert_eq(process.run("sh", show, env: some(["MAH_Z": "call"])).stdout, "call")
    assert_eq(process.run("sh", show).stdout, "table")
    assert_eq(process.env_get("MAH_Z").unwrap(), "table")
}

test "working directory" {
    let dir = fs.temp_dir()
    defer fs.remove(dir, recursive: true)
    assert_eq(process.run("sh", ["-c", "pwd"], cwd: some(dir)).stdout, dir + "\n")
    let e = assert_throws(fn() { process.run("sh", ["-c", "pwd"], cwd: some(dir + "/missing")) })
    assert_eq(e.message(), "sh: no such file or directory")
}

test "a program that can't be started" {
    let e = assert_throws(fn() { process.run("definitely-not-a-program-mah") })
    match e {
        ProcessError { kind, command, description } => {
            assert_eq(kind, "not_found")
            assert_eq(command, "definitely-not-a-program-mah")
            assert_eq(description, "no such file or directory")
        }
        _ => { assert(false) }
    }
    assert_eq(e.message(), "definitely-not-a-program-mah: no such file or directory")
}

test "a program that isn't executable" {
    let dir = fs.temp_dir()
    defer fs.remove(dir, recursive: true)
    fs.write_text(dir + "/plain", "not a program")
    let e = assert_throws(fn() { process.run(dir + "/plain") })
    match e {
        ProcessError { kind, command, description } => {
            assert_eq(kind + ": " + description, "permission_denied: permission denied")
        }
        _ => { assert(false) }
    }
}

test "shell" {
    assert_eq(process.shell("echo a | tr a b").stdout, "b\n")
    let missing = process.shell("definitely-not-a-program-mah 2>/dev/null")
    assert_eq(missing.code, 127)
    assert_eq(process.shell("cat", stdin: "in").stdout, "in")
    assert_eq(process.shell("printf %s \"$MAH_S\"", env: some(["MAH_S": "v"])).stdout, "v")
}

test "killed by a signal" {
    assert_eq(process.run("sh", ["-c", "kill -9 $$"]).code, 137)
}

test "output is decoded leniently" {
    let o = process.run("printf", ["a\\377b"])
    assert_eq(o.stdout, "a\uFFFDb")
}

test "the process itself" {
    let keys = process.env().keys()
    for let i in 1..keys.len() {
        assert(keys[i - 1] < keys[i])
    }
    assert(process.cwd().len() > 0)
    assert(process.cwd().starts_with("/"))
    assert(process.pid() > 0)
    assert_eq(process.platform(), "linux")
    assert_eq(process.args().len(), 0)
}
